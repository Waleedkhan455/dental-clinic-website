# Backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_NAME="Zimal Dental Clinic API"
ENVIRONMENT=development
API_PREFIX=/api

# --- MongoDB ---
# Local instance:  mongodb://localhost:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=zimal_dental

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth (JWT) ---
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
