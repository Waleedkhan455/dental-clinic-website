# Backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_NAME="Zimal Dental Clinic API"
ENVIRONMENT=development
API_PREFIX=/api

# --- MongoDB ---
# Local instance:  mongodb://localhost:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=zimal_dental

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth (JWT) ---
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default doctor/admin account (python -m app.seed_admin) ---
# If ADMIN_PASSWORD is left unset, the seed script generates one and prints it.
ADMIN_EMAIL=doctor@zimaldental.com
ADMIN_NAME=Zimal Dental Admin
# ADMIN_PASSWORD=

# --- Email (SMTP): patient appointment-confirmation emails ---
# Leave these unset to DISABLE sending (the app logs the email instead — nothing
# breaks). Set HOST + USER + PASSWORD to enable real delivery.
#   Port 587 → STARTTLS (SMTP_SSL=false). Port 465 → SMTP_SSL=true.
# Examples:
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (use a Google "App Password")
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SSL=false
# SMTP_STARTTLS=true
# SMTP_FROM_EMAIL=appointments@zimaldental.com
# SMTP_FROM_NAME=Zimal Dental Clinic
